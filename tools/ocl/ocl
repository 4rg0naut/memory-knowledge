#!/bin/sh
# Resolve an interpreter that has jsonschema (only `conform` needs it):
# local venv, then repo-root venv (README quick start), then python3.
HERE="$(cd "$(dirname "$0")" && pwd)"
for py in "$HERE/.venv/bin/python" "$HERE/../../.venv/bin/python" python3; do
  if command -v "$py" >/dev/null 2>&1 || [ -x "$py" ]; then
    exec "$py" "$HERE/ocl.py" "$@"
  fi
done
echo "ocl: no python interpreter found" >&2
exit 127
