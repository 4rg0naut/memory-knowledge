{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaims.org/schemas/openclaims/0.1/ClaimDisputedEvent.schema.json",
  "allOf": [
    { "$ref": "BaseEvent.schema.json" },
    {
      "type": "object",
      "required": ["claim_ref"],
      "properties": {
        "event_type": { "const": "claim.disputed" },
        "dispute_rationale": { "type": "string" }
      },
      "anyOf": [
        { "required": ["contradicting_evidence"] },
        { "required": ["dispute_rationale"] }
      ]
    }
  ]
}
