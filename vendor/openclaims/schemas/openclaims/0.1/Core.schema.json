{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaims.org/schemas/openclaims/0.1/Core.schema.json",
  "$defs": {
    "Digest": {
      "type": "object",
      "required": ["algorithm", "encoding", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "encoding": { "const": "base64url" },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Facet": {
      "type": "object",
      "required": ["_producer", "_schemaURL"],
      "properties": {
        "_producer": { "type": "string", "minLength": 1 },
        "_schemaURL": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "Agent": {
      "type": "object",
      "required": ["agent_id", "agent_type"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "agent_type": { "enum": ["human", "organization", "service", "model", "pipeline"] },
        "name": { "type": "string" },
        "uri": { "type": "string" },
        "facets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Facet" }
        }
      },
      "additionalProperties": false
    },
    "Selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": { "const": "text_span" },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "page", "start", "end"],
          "properties": {
            "type": { "const": "page_span" },
            "page": { "type": "integer", "minimum": 1 },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "json_pointer" },
            "path": { "type": "string", "pattern": "^/" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "row", "column"],
          "properties": {
            "type": { "const": "table_cell" },
            "row": { "type": "integer", "minimum": 0 },
            "column": { "type": ["integer", "string"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "fragment"],
          "properties": {
            "type": { "const": "uri_fragment" },
            "fragment": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": { "const": "byte_range" },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "ClaimRelation": {
      "type": "object",
      "required": ["relation_type", "claim_ref"],
      "properties": {
        "relation_type": { "enum": ["derived_from", "summarizes", "refines", "contradicts"] },
        "claim_ref": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "required": ["claim_id", "text", "claim_type", "asserted_at"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "claim_type": { "enum": ["factual", "calculation", "inference", "recommendation", "prediction"] },
        "subject": {},
        "context": {},
        "asserted_at": { "type": "string", "format": "date-time" },
        "valid_at": { "type": "string", "format": "date-time" },
        "derived_from_claims": { "type": "array", "items": { "type": "string" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/ClaimRelation" } },
        "facets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Facet" } }
      },
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "uri": { "type": "string" },
        "version": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "digest": { "$ref": "#/$defs/Digest" },
        "license": { "type": "string" },
        "facets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Facet" } }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "required": ["evidence_id", "source_ref", "selector", "support_type"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "claim_ref": { "type": "string" },
        "selector": { "$ref": "#/$defs/Selector" },
        "support_type": {
          "enum": ["supports_directly", "supports_partially", "computed_from", "contradicts", "context_only", "provenance_only"]
        },
        "content_digest": { "$ref": "#/$defs/Digest" },
        "observed_at": { "type": "string", "format": "date-time" },
        "facets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Facet" } }
      },
      "additionalProperties": false
    },
    "ToolRun": {
      "type": "object",
      "required": ["tool_run_id", "tool_type", "tool"],
      "properties": {
        "tool_run_id": { "type": "string", "minLength": 1 },
        "tool_type": { "type": "string", "minLength": 1 },
        "tool": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "container_digest": { "$ref": "#/$defs/Digest" },
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "model_version": { "type": "string" },
            "prompt_template_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "parameters_summary": {},
        "parameters_digest": { "$ref": "#/$defs/Digest" },
        "trace_ref": { "type": "string" },
        "facets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Facet" } }
      },
      "additionalProperties": false
    },
    "Inference": {
      "type": "object",
      "required": ["inference_id", "method", "input_refs", "output_claim_ref"],
      "properties": {
        "inference_id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "input_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "output_claim_ref": { "type": "string", "minLength": 1 },
        "tool_run_ref": { "type": "string" },
        "facets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Facet" } }
      },
      "additionalProperties": false
    },
    "Verification": {
      "type": "object",
      "required": ["verification_id", "verification_result", "verification_method", "claim_status", "validator", "verified_at"],
      "properties": {
        "verification_id": { "type": "string", "minLength": 1 },
        "verification_result": { "enum": ["supported", "contradicted", "inconclusive"] },
        "verification_method": { "enum": ["human_review", "model_check", "source_attestation", "consensus", "formal_proof"] },
        "claim_status": { "enum": ["active", "disputed", "retracted"] },
        "validator": { "$ref": "#/$defs/Agent" },
        "verified_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "facets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Facet" } }
      },
      "additionalProperties": false
    },
    "AuditableTrace": {
      "type": "object",
      "properties": {
        "event_ids": { "type": "array", "items": { "type": "string" } },
        "hash_chain": { "type": "array", "items": { "$ref": "#/$defs/Digest" } },
        "signature_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
